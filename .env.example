# OpenStore DZ — environment
#
# Copy to `.env` (local) or `.env.local` (some hosts) and fill in the values.
# NEVER commit the filled-in file. `.env.example` is the published reference.
#
# Rule of thumb: a `VITE_` prefix means the value is compiled into the browser
# bundle. Only the Supabase publishable key is allowed to carry that prefix.
# Anything secret belongs on the server and is never prefixed.

# -----------------------------------------------------------------------------
# Supabase — client (browser-visible)
# -----------------------------------------------------------------------------
# Supabase Dashboard -> your project -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public origin, used for canonical links and Open Graph URLs.
VITE_SITE_URL="https://your-shop.example"

# -----------------------------------------------------------------------------
# Guepex / Yalidine delivery (SERVER ONLY — never expose this to the browser)
# -----------------------------------------------------------------------------
# Get these from your own Guepex Developer Dashboard. They cannot be generated
# by an AI agent and must never be pasted into a chat.
# Docs: https://yalidine.com
GUEPEX_API_ID=""
GUEPEX_API_TOKEN=""
GUEPEX_BASE_URL="https://api.guepex.app/v1/"
# Only needed for the delivery-status webhook. Create the subscription first,
# then paste the secret here.
GUEPEX_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Optional: card payments (leave blank to run cash-on-delivery only)
# -----------------------------------------------------------------------------
# Per-shop Chargily credentials. Cash on delivery is the default and needs
# none of this.
CHARGILY_API_KEY=""