# Copy to .env (or your platform's secret manager) and fill in real values.
# Never commit the filled-in version. Never put these in client-side code.

# From the Développement page in the Guepex dashboard.
# Expires 365 days after generation — must be regenerated before then.
YALIDINE_API_ID=
YALIDINE_API_TOKEN=

YALIDINE_BASE_URL=https://api.guepex.app/v1/

# From the specific webhook's card in the Webhooks Dashboard.
# Only needed once you're implementing the webhook endpoint.
YALIDINE_WEBHOOK_SECRET=
